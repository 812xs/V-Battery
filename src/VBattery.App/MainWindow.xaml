<Window x:Class="VBattery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V-Battery" Width="940" Height="640" MinWidth="780" MinHeight="520"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Icon="/Assets/vbattery.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kenar çubuğu -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,26">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE83F;" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="V-Battery" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Dim}" Text="Cihaz pil izleyici" Margin="32,2,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Style="{StaticResource Dim}" Margin="8,0,0,0"/>
                <StackPanel>
                    <RadioButton x:Name="NavStatus" Style="{StaticResource NavButton}" Content="Durum" IsChecked="True" Checked="Nav_Checked" Tag="0"/>
                    <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" Content="Cihazlar" Checked="Nav_Checked" Tag="1"/>
                    <RadioButton x:Name="NavNotifications" Style="{StaticResource NavButton}" Content="Bildirimler" Checked="Nav_Checked" Tag="2"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Ayarlar" Checked="Nav_Checked" Tag="3"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,26,30,20">

            <!-- Durum -->
            <ScrollViewer x:Name="PageStatus" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Durum"/>
                    <TextBlock Style="{StaticResource Dim}" Text="Bağlı cihazlarınızın pil durumu tek bakışta." Margin="0,4,0,20"/>
                    <Border Style="{StaticResource Card}" Visibility="{Binding NoneConnected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Bağlı cihaz bulunamadı"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                       Text="Bluetooth veya USB ile bağlı bir cihaz pil bilgisi sunuyorsa burada görünür. Her cihaz pil bilgisi sunmaz; bu durumda cihaz 'Cihazlar' sekmesinde 'Pil bilgisi sunulmuyor' olarak listelenir."/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="260" Margin="0,0,16,16"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="28" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding BatteryText}" FontSize="30" FontWeight="SemiBold"
                                                       Foreground="{Binding BarBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,14,0,10" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Style="{StaticResource Bar}" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Foreground="{Binding BarBrush}"/>
                                        <TextBlock Style="{StaticResource Dim}" Text="{Binding StatusText}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Cihazlar -->
            <ScrollViewer x:Name="PageDevices" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Cihazlar"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,20"
                               Text="Algılanan tüm cihazlar. Göstergeden (tepsi ve masaüstü) gizleyebilir, bildirimleri cihaz başına açıp kapatabilirsiniz."/>
                    <TextBlock Style="{StaticResource Dim}" Text="Henüz cihaz algılanmadı."
                               Visibility="{Binding NoDevices, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="24" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Dim}" Text="{Binding StatusText}"/>
                                            <TextBlock Style="{StaticResource Dim}" Text="{Binding DetailText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding BatteryText}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{Binding BarBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource Switch}" Content="Göstergede göster" IsChecked="{Binding IsShown, Mode=TwoWay}" Margin="0,0,0,8"/>
                                            <CheckBox Style="{StaticResource Switch}" Content="Bildirimler" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Bildirimler -->
            <ScrollViewer x:Name="PageNotifications" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Bildirimler"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,20" Text="Pil seviyesi için Windows bildirimleri."/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkLow" Style="{StaticResource Switch}" Content="Düşük pil bildirimi"/>
                            <TextBlock Style="{StaticResource H2}" Text="Uyarı seviyesi" Margin="0,18,0,10"/>
                            <StackPanel x:Name="ThresholdPanel" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegButton}" Content="%10" Tag="10"/>
                                <RadioButton Style="{StaticResource SegButton}" Content="%15" Tag="15"/>
                                <RadioButton Style="{StaticResource SegButton}" Content="%20" Tag="20"/>
                                <RadioButton Style="{StaticResource SegButton}" Content="%30" Tag="30"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,12,0,0"
                                       Text="%5 seviyesinde ayrıca kritik pil uyarısı gösterilir. Yüzde vermeyen cihazlarda (ör. Xbox gamepad) 'Düşük' ve 'Boş' seviyesi kullanılır."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkCharge" Style="{StaticResource Switch}" Content="Şarj tamamlandığında bildir"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                       Text="Yalnızca cihaz şarj durumunu bildiriyorsa çalışır."/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnTest" Style="{StaticResource ActionButton}" Content="Bildirimi test et" HorizontalAlignment="Left" Click="BtnTest_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Ayarlar -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Ayarlar"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,20" Text="Başlangıç, tepsi ve masaüstü göstergesi."/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Başlangıç" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ChkAutoStart" Style="{StaticResource Switch}" Content="Windows ile başlat" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkStartMin" Style="{StaticResource Switch}" Content="Ana pencere yerine sistem tepsisinde başlat"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Görev çubuğu" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ChkTray" Style="{StaticResource Switch}" Content="Pil göstergelerini bildirim alanında göster"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                       Text="Windows yeni simgeleri varsayılan olarak taşma menüsüne koyabilir. Simgeleri saatin yanına sabitlemek için Ayarlar &gt; Kişiselleştirme &gt; Görev çubuğu &gt; Diğer sistem tepsisi simgeleri bölümünden V-Battery'yi açın."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Masaüstü göstergesi" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ChkFloating" Style="{StaticResource Switch}" Content="Masaüstünde serbest göster" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkTop" Style="{StaticResource Switch}" Content="Her zaman üstte" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkDark" Style="{StaticResource Switch}" Content="Koyu arka plan (kapalıysa saydam)" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkClock" Style="{StaticResource Switch}" Content="Saat ve tarihi göster" Margin="0,0,0,16"/>
                            <TextBlock Style="{StaticResource Dim}" Text="Simge boyutu" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ScalePanel" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegButton}" Content="Küçük" Tag="0.75"/>
                                <RadioButton Style="{StaticResource SegButton}" Content="Normal" Tag="1"/>
                                <RadioButton Style="{StaticResource SegButton}" Content="Büyük" Tag="1.25"/>
                                <RadioButton Style="{StaticResource SegButton}" Content="Çok büyük" Tag="1.5"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                       Text="Göstergeyi sürükleyerek taşıyabilirsiniz; konum kaydedilir."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Tanılama" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SettingsPathText" Style="{StaticResource Dim}" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource ActionButton}" Content="Tanılama raporunu aç" HorizontalAlignment="Left" Click="BtnDiag_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
