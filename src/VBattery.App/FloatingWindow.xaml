<Window x:Class="VBattery.App.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V-Battery Gösterge" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Icon="/Assets/vbattery.ico" FontFamily="Segoe UI">
    <Border x:Name="Root" CornerRadius="14" Padding="14,10" Cursor="SizeAll"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel x:Name="Content">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="Black"/>
            </StackPanel.Effect>
            <TextBlock x:Name="ClockText" Foreground="#ECECF1" FontSize="12" Margin="2,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                    Visibility="{Binding IsVisibleInIndicator, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BatteryText}" FontSize="15" FontWeight="SemiBold" MinWidth="52"
                                       Foreground="{Binding BarBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#9A9AAB" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
